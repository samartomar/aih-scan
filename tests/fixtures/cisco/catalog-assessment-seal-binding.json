  "sources": {
    "LICENSE": "Apache License\nVersion 2.0, January 2004\nhttp://www.apache.org/licenses/\n\nLicensed under the Apache License, Version 2.0 (the \"License\");\nyou may not use this file except in compliance with the License.\nYou may obtain a copy of the License at\n\n    http://www.apache.org/licenses/LICENSE-2.0\n\nUnless required by applicable law or agreed to in writing, software\ndistributed under the License is distributed on an \"AS IS\" BASIS,\nWITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\nSee the License for the specific language governing permissions and\nlimitations under the License.\n",
    "SKILL.md": "---\nname: aih-gov-doctor\ndescription: Declarative Audit and Guide source material for Governance Doctor profiles.\nlicense: Apache-2.0\n---\n\n# Governance Doctor Audit and Guide\n\nUse this source material to describe read-only Governance Doctor Audit and Guide\nfacts. It contains no Repair behavior and does not create authority to change a\ndestination.\n\nThe profile is canonical data. Its identifiers name only the closed read-only\nAIH surfaces represented by the profile contract. It describes reviewing\nprecomputed AIH-produced read-only diagnostic results. Findings and guidance\nremain source-attributed and non-authoritative.\n\nScaffolding copies this first-party source into a destination. The destination\nlifecycle is responsible for subsequent governance and approval before any use.\n",
    "profile.json": "{\"conflicts\":[{\"conflictId\":\"mcp-controls\",\"conflictsWithSurfaceId\":\"surface:aih.mcp-controls\",\"note\":{\"attribution\":\"catalog:aih/governance-doctor\",\"text\":\"Both surfaces claim the same MCP control target.\"}}],\"diagnosticIds\":[\"aih.doctor.root\",\"aih.policy.evaluate\"],\"effectVersion\":\"1\",\"governanceDoctorProfileSha256\":\"a9bcdad3ab14d82a08b01e42ec78d154b57f9e987c5d4c0824002ad3f0e8b632\",\"guidance\":{\"attribution\":\"catalog:aih/governance-doctor\",\"text\":\"Review precomputed AIH-produced read-only diagnostic results before deciding anything.\"},\"nextActionId\":\"aih.status.root\",\"prerequisites\":[{\"note\":{\"attribution\":\"catalog:aih/governance-doctor\",\"text\":\"A committed effective policy revision must exist.\"},\"prerequisiteId\":\"effective-policy\",\"satisfiedBy\":\"org-policy\"}],\"profileVersion\":\"1\",\"protocol\":\"GovernanceDoctorProfileV1\",\"repairPosture\":\"guided-only\",\"roles\":[{\"owner\":\"aih\",\"roleId\":\"policy-owner\",\"summary\":{\"attribution\":\"catalog:aih/governance-doctor\",\"text\":\"AIH owns the policy decision for this surface.\"}}],\"schemaVersion\":\"1\",\"surfaceId\":\"surface:aih.governance-doctor\",\"targetId\":\"target:aih.workstation\"}"
