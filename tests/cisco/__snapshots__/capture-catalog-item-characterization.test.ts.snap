exports[`capture-catalog-item command characterization > keeps its exported names 1`] = `
[
  "assertPlatform",
  "assertSkillSourceRoot",
  "attemptCapture",
  "createRunDirectory",
  "installEnvironment",
  "npmCliPath",
  "prepareCapture",
  "readCatalogSourceClosure",
  "readDetectorInputs",
  "runPreparedCapture",
]
`;

