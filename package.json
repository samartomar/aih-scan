{
  "name": "@aihq/scan",
  "version": "1.0.0",
  "description": "Strict, non-authoritative candidate and signed evidence contracts for AI Harness scanners.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samartomar/aih-scan.git"
  },
  "homepage": "https://github.com/samartomar/aih-scan#readme",
  "bugs": {
    "url": "https://github.com/samartomar/aih-scan/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "aih-scan": "./dist/cli.js"
  },
  "files": [
    "dist",
    "tools/verify-core-contract-lock-v2.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "prepack": "npm run build",
    "repo:doctor": "node tools/repo-ai-tools.mjs doctor-codex",
    "repo:init": "node tools/repo-ai-tools.mjs setup-codex",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "zod": "4.4.3"
  }
}
