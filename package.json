{
  "name": "@aihq/scan",
  "version": "0.0.0-dev.1",
  "description": "Content assessment for AI agent content: scan exact bytes without running them, then read, match and verify the results.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samartomar/aih-scan.git"
  },
  "homepage": "https://github.com/samartomar/aih-scan#readme",
  "bugs": {
    "url": "https://github.com/samartomar/aih-scan/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25 || >=26.12.1 <27"
  },
  "exports": {
    "./host": {
      "types": "./dist/public/host.d.ts",
      "import": "./dist/public/host.js"
    },
    "./read": {
      "types": "./dist/public/read.d.ts",
      "import": "./dist/public/read.js"
    },
    "./contracts": {
      "types": "./dist/public/contracts.d.ts",
      "import": "./dist/public/contracts.js"
    },
    "./schemas/aih-scan-request-1.json": "./schemas/aih-scan-request-1.json",
    "./schemas/aih-scan-source-1.json": "./schemas/aih-scan-source-1.json",
    "./schemas/aih-scan-summary-1.json": "./schemas/aih-scan-summary-1.json",
    "./schemas/aih-scan-withdrawn-1.json": "./schemas/aih-scan-withdrawn-1.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "aih-scan": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "trust",
    "docs/scan-sources.md",
    "docs/analyzers.md",
    "docs/verification.md",
    "docs/advisories.md",
    "CONTRACTS.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "generate:identity": "node tools/generate-package-identity.mjs",
    "build": "npm run generate:identity && tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "prepack": "npm run build",
    "repo:doctor": "node tools/repo-ai-tools.mjs doctor-codex",
    "repo:init": "node tools/repo-ai-tools.mjs setup-codex",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify:workflow-action-pins": "node tools/verify-pinned-actions.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test && npm run verify:workflow-action-pins"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "2.5.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  }
}
