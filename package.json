{
  "name": "@aihq/scan",
  "version": "0.5.0",
  "description": "AIH Scanner evidence producer for AI Development Assurance.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samartomar/aih-scan.git"
  },
  "homepage": "https://github.com/samartomar/aih-scan#readme",
  "bugs": {
    "url": "https://github.com/samartomar/aih-scan/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/public/contracts.d.ts",
      "import": "./dist/public/contracts.js"
    },
    "./read": {
      "types": "./dist/public/read.d.ts",
      "import": "./dist/public/read.js"
    },
    "./host": {
      "types": "./dist/public/host.d.ts",
      "import": "./dist/public/host.js"
    },
    "./schemas/request/1.0.0.json": "./schemas/request/1.0.0.json",
    "./schemas/run-result/1.0.0.json": "./schemas/run-result/1.0.0.json",
    "./schemas/report/1.0.0.json": "./schemas/report/1.0.0.json",
    "./schemas/artifact/1.0.0.json": "./schemas/artifact/1.0.0.json",
    "./schemas/evidence-association/1.0.0.json": "./schemas/evidence-association/1.0.0.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "aih-scan": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "tools/baseline-analyzers",
    "tools/verify-core-contract-lock-v2.mjs"
  ],
  "scripts": {
    "generate:identity": "node tools/generate-package-identity.mjs",
    "build": "npm run generate:identity && tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "prepack": "npm run build",
    "repo:doctor": "node tools/repo-ai-tools.mjs doctor-codex",
    "repo:init": "node tools/repo-ai-tools.mjs setup-codex",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify:cold-core-evidence": "node tools/verify-cold-core-evidence.mjs",
    "verify:workflow-action-pins": "node tools/verify-pinned-actions.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test && npm run verify:workflow-action-pins"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "20.11.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@sigstore/bundle": "5.0.0",
    "@sigstore/protobuf-specs": "0.5.0",
    "@sigstore/verify": "4.1.2",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  }
}
