{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*.ts",
      "tests/**/*.ts",
      "*.config.ts",
      "tools/**/*.mjs",
      "examples/saved-findings-mcp/*.mjs",
      "examples/saved-findings-mcp/package.json"
    ]
  },
  "overrides": [
    {
      "includes": ["tools/**/*.mjs"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    }
  ],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "off"
      }
    }
  }
}
