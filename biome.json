{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts", "tools/**/*.mjs"]
  },
  "overrides": [
    {
      "includes": ["tools/**/*.mjs"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": ["tools/prepare-aih-delivery-publication.mjs"],
      "linter": { "rules": { "suspicious": { "useIterableCallbackReturn": "off" } } }
    },
    {
      "includes": ["tools/verify-cisco-oci-candidate.mjs"],
      "linter": { "rules": { "suspicious": { "noShadowRestrictedNames": "off" } } }
    }
  ],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "off"
      }
    }
  }
}
