+def _tp4_capacity(name: str, default: int) -> int:
+    value = os.environ.get(name)
+    if value is None or not value.strip():
+        return default
+    digits = value.strip().lstrip("0")
+    if re.fullmatch(r"[0-9]{1,4}", digits) and 1 <= int(digits) <= 4096:
+        return int(digits)
+    logger.warning("%s must be a decimal integer from 1 to 4096; using default %d", name, default)
+    return default
+
+
+TP4_MAX_FILES = _tp4_capacity("SKILLSPECTOR_TP4_MAX_FILES", DEFAULT_TP4_MAX_FILES)
+TP4_MAX_FINDINGS = _tp4_capacity("SKILLSPECTOR_TP4_MAX_FINDINGS", DEFAULT_TP4_MAX_FINDINGS)
+
 
