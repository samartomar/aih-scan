{
  "$id": "https://github.com/samartomar/aih-scan/schemas/aih-scan-request-1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aih-scan-request/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "origin"
  ],
  "oneOf": [
    {
      "required": [
        "source"
      ]
    },
    {
      "required": [
        "items"
      ]
    }
  ],
  "properties": {
    "format": {
      "const": "aih-scan-request/1"
    },
    "source": {
      "$id": "https://github.com/samartomar/aih-scan/schemas/aih-scan-source-1.json",
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "aih-scan-source/1",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "format": {
              "const": "aih-scan-source/1"
            },
            "type": {
              "const": "folder"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "repo"
          ],
          "properties": {
            "format": {
              "const": "aih-scan-source/1"
            },
            "type": {
              "const": "git"
            },
            "repo": {
              "type": "string",
              "pattern": "^https://"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "kind": {
              "enum": [
                "skill",
                "agent",
                "command",
                "rule",
                "hook",
                "mcp"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "package",
            "version"
          ],
          "properties": {
            "format": {
              "const": "aih-scan-source/1"
            },
            "type": {
              "const": "npm"
            },
            "package": {
              "type": "string",
              "minLength": 1,
              "maxLength": 214
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "mcp"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "format": {
              "const": "aih-scan-source/1"
            },
            "type": {
              "const": "npm-file"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "mcp"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "format": {
              "const": "aih-scan-source/1"
            },
            "type": {
              "const": "remote"
            },
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "kind": {
              "const": "mcp"
            }
          }
        }
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "origin": {
      "enum": [
        "published",
        "local"
      ]
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "skill",
          "agent",
          "command",
          "rule",
          "hook",
          "mcp"
        ]
      }
    },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "skillspector",
          "aih-trust-lint",
          "cisco"
        ]
      }
    },
    "mode": {
      "enum": [
        "static",
        "ai"
      ]
    }
  }
}
