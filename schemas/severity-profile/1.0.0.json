{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "urn:aihq:scan:severity-profile:1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "rules": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "detectorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "level": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "maps": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "note",
              "unavailable"
            ]
          }
        },
        "required": [
          "detectorId",
          "level",
          "maps"
        ],
        "additionalProperties": false
      }
    },
    "suppressions": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "detectorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "nativeRuleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[^\\\\%?#:\\u0000-\\u001f\\u007f]+(?<!\\/)$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        },
        "required": [
          "detectorId",
          "nativeRuleId",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "rules",
    "suppressions"
  ],
  "additionalProperties": false,
  "$id": "urn:aihq:scan:severity-profile:1.0.0"
}
